# ---------------------------------------------------------------------------
# AI IELTS Writing Scorer — environment variables
# Copy to .env (and .env.local for Next.js dev) and fill in real values.
# NEVER commit real secrets. The Gemini key must stay server-side only.
# ---------------------------------------------------------------------------

# PostgreSQL connection string (managed Postgres recommended in production)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ielts_scorer?schema=public"

# Secret used to sign session JWTs. Generate with: openssl rand -base64 48
AUTH_SECRET="change-me-to-a-long-random-string"

# Google Gemini API key (server-side only — never exposed to the browser)
GEMINI_API_KEY=""

# Default Gemini model used when no routing rule / prompt override applies
GEMINI_DEFAULT_MODEL="gemini-2.5-flash"

# Seed admin credentials (used by prisma/seed.ts on first run)
SEED_ADMIN_EMAIL="admin@ielts-scorer.local"
SEED_ADMIN_PASSWORD="ChangeMe123!"

# Optional: default USD -> VND exchange rate for the seed
SEED_USD_VND_RATE="25400"
